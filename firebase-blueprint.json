{
  "entities": {
    "Todo": {
      "title": "Todo",
      "description": "A single todo task",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique task ID"
        },
        "text": {
          "type": "string",
          "description": "The task text"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the task is completed"
        },
        "column": {
          "type": "string",
          "description": "The target column: week, month, or goals"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in MS"
        },
        "userId": {
          "type": "string",
          "description": "The Firebase Auth UID of the owner"
        }
      },
      "required": ["id", "text", "completed", "column", "createdAt", "userId"]
    }
  },
  "firestore": {
    "todos/{todoId}": {
      "schema": "Todo",
      "description": "A collection of todo items created by authenticated users"
    }
  }
}
